<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Taskly.Views"
        x:Class="Taskly.MainWindow"
        Title="Taskly"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <DockPanel LastChildFill="True">

        <!-- 顶部菜单栏（Windows/Linux 用；macOS 用系统菜单栏，此控件在 macOS 上隐藏） -->
        <Menu x:Name="WindowMenuBar" DockPanel.Dock="Top" Height="32">
            <MenuItem x:Name="MenuFile">
                <MenuItem x:Name="MenuNewDatabase" Click="OnMenuNewDb" InputGesture="Ctrl+N"/>
                <MenuItem x:Name="MenuOpenDatabase" Click="OnMenuOpenDb" InputGesture="Ctrl+O"/>
                <MenuItem x:Name="MenuCloseDatabase" Click="OnMenuCloseDb" InputGesture="Ctrl+W"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Click="OnMenuExit" InputGesture="Ctrl+Q"/>
            </MenuItem>
            <MenuItem x:Name="MenuSettings">
                <MenuItem x:Name="MenuLanguage">
                    <MenuItem x:Name="MenuLangZh" Click="OnMenuLangZh" ToggleType="Radio" IsChecked="{Binding IsChinese}"/>
                    <MenuItem x:Name="MenuLangEn" Header="English" Click="OnMenuLangEn" ToggleType="Radio"/>
                </MenuItem>
                <MenuItem x:Name="MenuDarkMode" Click="OnMenuToggleTheme" ToggleType="CheckBox" IsChecked="{Binding IsDark}"/>
            </MenuItem>
            <MenuItem x:Name="MenuTools">
                <MenuItem x:Name="MenuInstallCli" Click="OnMenuInstallCli"/>
                <MenuItem x:Name="MenuUninstallCli" Click="OnMenuUninstallCli"/>
            </MenuItem>
            <MenuItem x:Name="MenuHelp">
                <MenuItem x:Name="MenuAbout" Click="OnMenuAbout"/>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Classes="status-bar" Height="28">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
        </Border>

        <!-- 主内容区：侧边栏 + 分隔线 + 任务面板。
             侧边栏用固定像素列（可被 GridSplitter 平滑拖拽改宽）；
             收起时列宽动画过渡到 0。 -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧栏 -->
            <v:ListPane x:Name="ListPaneControl" Grid.Column="0"
                        IsVisible="{Binding IsSidebarVisible}"/>

            <!-- 分隔线：5px 透明命中区（好拖），内部居中 1px 实线（视觉细，减少与侧边栏的空隙） -->
            <GridSplitter x:Name="Splitter" Grid.Column="1"
                          Width="5"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Border Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center"
                                    Background="{DynamicResource ThemeDividerBrush}"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 任务面板 -->
            <v:TaskPane x:Name="TaskPaneControl" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
