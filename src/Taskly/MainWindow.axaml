<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Taskly.Views"
        x:Class="Taskly.MainWindow"
        Title="Taskly"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <DockPanel LastChildFill="True">

        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top" Height="32">
            <MenuItem x:Name="MenuFile" Header="文件">
                <MenuItem x:Name="MenuNewDatabase" Header="新建数据库" Click="OnMenuNewDb" InputGesture="Ctrl+N"/>
                <MenuItem x:Name="MenuOpenDatabase" Header="打开数据库" Click="OnMenuOpenDb" InputGesture="Ctrl+O"/>
                <MenuItem x:Name="MenuCloseDatabase" Header="关闭数据库" Click="OnMenuCloseDb" InputGesture="Ctrl+W"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="退出" Click="OnMenuExit" InputGesture="Ctrl+Q"/>
            </MenuItem>
            <MenuItem x:Name="MenuSettings" Header="设置">
                <MenuItem x:Name="MenuLanguage" Header="语言">
                    <MenuItem x:Name="MenuLangZh" Header="简体中文" Click="OnMenuLangZh" ToggleType="Radio" IsChecked="{Binding IsChinese}"/>
                    <MenuItem x:Name="MenuLangEn" Header="English" Click="OnMenuLangEn" ToggleType="Radio"/>
                </MenuItem>
                <MenuItem x:Name="MenuDarkMode" Header="深色模式" Click="OnMenuToggleTheme" ToggleType="CheckBox" IsChecked="{Binding IsDark}"/>
            </MenuItem>
            <MenuItem x:Name="MenuHelp" Header="帮助">
                <MenuItem x:Name="MenuAbout" Header="关于" Click="OnMenuAbout"/>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Classes="status-bar" Height="28">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
        </Border>

        <!-- 主内容区：侧边栏 + 任务面板 -->
        <Grid ColumnDefinitions="Auto,Auto,*">

            <!-- 左侧栏 -->
            <v:ListPane x:Name="ListPaneControl" Grid.Column="0" Width="280"
                        IsVisible="{Binding IsSidebarVisible}"/>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ThemeDividerBrush}"
                          ResizeDirection="Columns"/>

            <!-- 任务面板 -->
            <v:TaskPane x:Name="TaskPaneControl" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
