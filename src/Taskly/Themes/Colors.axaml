<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 智能列表语义色（Reminders 语义：蓝/红/灰，固定不随主题变化） -->
    <SolidColorBrush x:Key="SmartListTodayBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="SmartListScheduledBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="SmartListAllBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="SmartListCompletedBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="SmartListFlaggedBrush" Color="#FF9500"/>

    <!-- 强调色（系统蓝，macOS 默认 accent；暗色主题在 AppTheme 覆盖为略亮） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>

    <!-- 共享尺寸常量 -->
    <x:Double x:Key="SidebarWidth">280</x:Double>
    <x:Double x:Key="StatusBarHeight">28</x:Double>
    <x:Double x:Key="MenuBarHeight">32</x:Double>
    <x:Double x:Key="CheckboxSize">22</x:Double>
    <x:Double x:Key="ListIconSize">32</x:Double>

    <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>

</ResourceDictionary>
