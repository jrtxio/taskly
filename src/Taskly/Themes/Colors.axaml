<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 智能列表语义色（Anthropic 暖色变体，固定不随主题变化） -->
    <SolidColorBrush x:Key="SmartListTodayBrush" Color="#C15F3C"/>
    <SolidColorBrush x:Key="SmartListScheduledBrush" Color="#B5543A"/>
    <SolidColorBrush x:Key="SmartListAllBrush" Color="#8E887E"/>
    <SolidColorBrush x:Key="SmartListCompletedBrush" Color="#6B8E5A"/>
    <SolidColorBrush x:Key="SmartListFlaggedBrush" Color="#C98642"/>

    <!-- 强调色（Crail 赤陶，Anthropic 标志色；暗色主题在 AppTheme 覆盖为略亮） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C15F3C"/>

    <!-- 共享尺寸常量 -->
    <x:Double x:Key="SidebarWidth">280</x:Double>
    <x:Double x:Key="StatusBarHeight">28</x:Double>
    <x:Double x:Key="MenuBarHeight">32</x:Double>
    <x:Double x:Key="CheckboxSize">22</x:Double>
    <x:Double x:Key="ListIconSize">32</x:Double>

    <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>

</ResourceDictionary>
