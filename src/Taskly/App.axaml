<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Taskly.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Taskly/Themes/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Taskly/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 默认浅色主题下的语义色画刷（Anthropic 暖色调） -->
            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#FFF4F3EE"/>
            <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#FFECEAE3"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFAF9F5"/>
            <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFF4F3EE"/>
            <SolidColorBrush x:Key="ThemeDividerBrush" Color="#FFD9D6CE"/>
            <SolidColorBrush x:Key="ThemeOnSurfaceBrush" Color="#FF2B2825"/>
            <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#FF6B6862"/>
            <SolidColorBrush x:Key="ThemeTertiaryTextBrush" Color="#FF9B9890"/>
            <SolidColorBrush x:Key="ThemeSelectionBackgroundBrush" Color="#38C15F3C"/>
            <SolidColorBrush x:Key="ThemeHoverBackgroundBrush" Color="#142B2825"/>
            <SolidColorBrush x:Key="ThemeBadgeBackgroundBrush" Color="#FFE0DDD4"/>
            <SolidColorBrush x:Key="ThemeBadgeTextBrush" Color="#FF3C3934"/>
            <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#FFD9D6CE"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
