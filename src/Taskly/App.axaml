<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Taskly.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Taskly/Themes/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Taskly/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 默认浅色主题下的语义色画刷（macOS Reminders 风格中性色） -->
            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#FFF2F2F2"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ThemeDividerBrush" Color="#FFE3E3E8"/>
            <SolidColorBrush x:Key="ThemeOnSurfaceBrush" Color="#FF1D1D1F"/>
            <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#FF8E8E93"/>
            <SolidColorBrush x:Key="ThemeTertiaryTextBrush" Color="#FFB0B0B5"/>
            <SolidColorBrush x:Key="ThemeSelectionBackgroundBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="ThemeHoverBackgroundBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="ThemeBadgeBackgroundBrush" Color="#FFE9E9EE"/>
            <SolidColorBrush x:Key="ThemeBadgeTextBrush" Color="#FF58585D"/>
            <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#FFC7C7CC"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
