<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Taskly.Models"
             xmlns:c="clr-namespace:Taskly.Converters"
             x:Class="Taskly.Views.ListPane"
             Background="{DynamicResource ThemeSidebarBrush}">

    <UserControl.Resources>
        <c:ColorToBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.smart-tile">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.smart-tile:pointerover">
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Border.list-row">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- 淡底色 + 细边框，让列表项有明确的视觉容器感。 -->
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.list-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.list-row.selected">
            <Setter Property="Background" Value="{DynamicResource ThemeSelectionBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="0">

            <!-- 智能视图四宫格 -->
            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">

                <Border Classes="smart-tile" Margin="0,0,5,5"
                        Background="{StaticResource SmartListTodayBrush}"
                        PointerPressed="OnTodayPressed">
                    <Panel>
                        <TextBlock Text="🗓" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                        <TextBlock Text="{Binding TodayCount}" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBlock x:Name="TodayLabel" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"/>
                    </Panel>
                </Border>

                <Border Classes="smart-tile" Margin="5,0,0,5"
                        Background="{StaticResource SmartListScheduledBrush}"
                        PointerPressed="OnPlannedPressed">
                    <Panel>
                        <TextBlock Text="📅" FontSize="16" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                        <TextBlock Text="{Binding PlannedCount}" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBlock x:Name="PlannedLabel" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"/>
                    </Panel>
                </Border>

                <Border Classes="smart-tile" Margin="0,5,5,0"
                        Background="{StaticResource SmartListAllBrush}"
                        PointerPressed="OnAllPressed">
                    <Panel>
                        <TextBlock Text="≡" FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                        <TextBlock Text="{Binding AllCount}" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBlock x:Name="AllLabel" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"/>
                    </Panel>
                </Border>

                <Border Classes="smart-tile" Margin="5,5,0,0"
                        Background="{StaticResource SmartListCompletedBrush}"
                        PointerPressed="OnCompletedPressed">
                    <Panel>
                        <TextBlock Text="✓" FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                        <TextBlock Text="{Binding CompletedCount}" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBlock x:Name="CompletedLabel" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10"/>
                    </Panel>
                </Border>
            </UniformGrid>

            <!-- 「我的列表」标题 + 添加按钮 -->
            <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,8">
                <Button Background="Transparent" BorderThickness="0" Padding="4,2"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        Click="OnToggleMyLists">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▼" FontSize="9" VerticalAlignment="Center"
                                   IsVisible="{Binding IsMyListsExpanded}"/>
                        <TextBlock Text="▶" FontSize="9" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsMyListsExpanded}"/>
                        <TextBlock x:Name="MyListsLabel"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4,2"
                        Click="OnAddList">
                    <TextBlock Text="✚" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                </Button>
            </Grid>

            <!-- 列表项 -->
            <ItemsControl x:Name="ListsControl" IsVisible="{Binding IsMyListsExpanded}" ItemsSource="{Binding Lists}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:TodoList">
                        <Border Classes="list-row"
                                x:Name="RowBorder"
                                PointerPressed="OnListPointerPressed"
                                DoubleTapped="OnListDoubleTapped">
                            <Grid ColumnDefinitions="32,*,Auto">
                                <!-- 图标圆 -->
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}, TargetNullValue={DynamicResource AccentBrush}}">
                                    <TextBlock Text="{Binding Icon, FallbackValue=📋, TargetNullValue=📋}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- 名称 -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <!-- 计数 -->
                                <TextBlock Grid.Column="2" Text="{Binding PendingCount}" VerticalAlignment="Center" Margin="0,0,4,0"
                                           FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                                           IsVisible="{Binding PendingCount, Converter={x:Static c:CountToVisibilityConverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
