<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Taskly.Converters"
             x:Class="Taskly.Views.TaskItemRow">

    <UserControl.ContextMenu>
        <ContextMenu x:Name="TaskContextMenu" Opening="OnContextMenuOpening">
            <MenuItem x:Name="ToggleMenuItem" Click="OnToggle"/>
            <MenuItem x:Name="DeleteMenuItem" Click="OnDelete"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border Classes="task-row" DoubleTapped="OnRowDoubleTapped">

        <Panel>
            <!-- ============ 默认态（编辑态隐藏） ============
                 主行：复选框 + 任务文字 + 详情按钮。
                 元信息（日期/时间/备注）仅在已有值时显示，节省视觉空间。 -->
            <StackPanel x:Name="ViewModeRow">
                <!-- 主行 -->
                <Grid ColumnDefinitions="24,*,28" Height="30">
                    <CheckBox Grid.Column="0" Classes="reminder" IsChecked="{Binding Completed}"
                              Click="OnToggle"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding !Completed}"
                                         x:Name="TitleLabel"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding Completed}"
                                         Foreground="{DynamicResource ThemeTertiaryTextBrush}"
                                         x:Name="TitleLabelDone">
                        <SelectableTextBlock.TextDecorations>
                            <TextDecorationCollection>
                                <TextDecoration Location="Strikethrough" Stroke="{DynamicResource ThemeTertiaryTextBrush}" StrokeThickness="1" StrokeOffset="0.1"/>
                            </TextDecorationCollection>
                        </SelectableTextBlock.TextDecorations>
                    </SelectableTextBlock>
                    <Button Grid.Column="2" x:Name="InfoBtn" Classes="task-detail-btn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnInfoClick">
                        <TextBlock Text="ⓘ" FontSize="13"/>
                    </Button>
                </Grid>

                <!-- 元信息区：仅当有日期/时间/备注时显示（由 code-behind 控制 IsVisible） -->
                <StackPanel x:Name="MetaPanel" Margin="24,2,0,0" Spacing="3" IsVisible="False">
                    <!-- 日期（有值才显示） -->
                    <TextBlock x:Name="DatePreview" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                               IsVisible="False"/>
                    <!-- 备注预览（有值才显示，单行省略） -->
                    <TextBlock x:Name="NotesPreview" FontSize="12"
                               Foreground="{DynamicResource ThemeTertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="False"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ 编辑态（默认隐藏，双击展开） ============
                 文字 + 日期按钮 + 时间按钮 + 备注，全部可改。 -->
            <StackPanel x:Name="EditModePanel" Spacing="8" IsVisible="False">
                <!-- 文字输入框行 -->
                <Grid ColumnDefinitions="24,*,28" Height="30">
                    <CheckBox Grid.Column="0" Classes="reminder" IsChecked="{Binding Completed}"
                              Click="OnToggle"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TaskTextEdit" FontSize="14"
                             VerticalAlignment="Center"
                             Padding="6,3" CornerRadius="4"
                             BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                             LostFocus="OnEditAreaLostFocus"
                             KeyDown="OnTextEditKeyDown"/>
                    <Button Grid.Column="2" x:Name="InfoBtnEdit" Classes="task-detail-btn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnInfoClick" ToolTip.Tip="详情与编辑">
                        <TextBlock Text="ⓘ" FontSize="13"/>
                    </Button>
                </Grid>

                <!-- 日期 + 时间按钮（编辑态始终显示，可独立添加/修改） -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,0,0,0">
                    <Button Classes="task-meta-btn" Click="OnDateClick" MinHeight="28">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🗓" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="DateText" FontSize="12"
                                       Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="task-meta-btn" Click="OnTimeClick" MinHeight="28">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🕐" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="TimeText" FontSize="12"
                                       Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 备注（编辑态显示，多行：回车换行，与标题的"回车退出"区分） -->
                <TextBox x:Name="NotesEdit" Classes="task-notes-edit"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="24,0,0,0"
                         LostFocus="OnNotesLostFocus"/>
            </StackPanel>
        </Panel>
    </Border>
</UserControl>
