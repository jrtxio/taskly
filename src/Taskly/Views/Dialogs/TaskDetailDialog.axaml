<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.TaskDetailDialog"
        Width="450" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="任务详情">

    <Border Padding="24">
        <StackPanel Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TaskLabel" Text="任务" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                <TextBox x:Name="TaskBox" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock x:Name="NotesLabel" Text="备注" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                         Watermark="添加备注..."/>
            </StackPanel>

            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock x:Name="DateLabel" Text="日期" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    <!-- 用 Button 替代只读 TextBox：Click 100% 可靠，解决 PointerReleased 不触发导致无法添加日期 -->
                    <Button x:Name="DateBtn" Click="OnPickDate" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" MinHeight="34">
                        <TextBlock x:Name="DateText" Text="添加日期" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock x:Name="TimeLabel" Text="时间" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    <Button x:Name="TimeBtn" Click="OnPickTime" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" MinHeight="34">
                        <TextBlock x:Name="TimeText" Text="添加时间" Foreground="{DynamicResource ThemeTertiaryTextBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="DeleteBtn" Content="删除" Click="OnDelete" Classes="danger" MinWidth="80" MinHeight="36"/>
                <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" MinWidth="80" MinHeight="36"/>
                <Button x:Name="SaveBtn" Content="保存" Click="OnSave" Classes="accent" MinWidth="80" MinHeight="36"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
