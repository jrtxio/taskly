<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.TimePickerDialog"
        Width="300" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="选择时间"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <DockPanel LastChildFill="True" Margin="4">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="12,8">
            <Button x:Name="ClearBtn" Content="清除" Click="OnClear" MinWidth="64" MinHeight="34"/>
            <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" MinWidth="64" MinHeight="34"/>
            <Button x:Name="ConfirmBtn" Content="确定" Click="OnConfirm" Classes="accent" MinWidth="64" MinHeight="34"/>
        </StackPanel>

        <!-- 时:分 选择（用 ComboBox 替代内置 TimePicker 滚轮，数字垂直居中可控） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="8,16">
            <StackPanel Spacing="6">
                <TextBlock x:Name="HourLabel" Text="时" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <ComboBox x:Name="HourBox" MinWidth="72" HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text=":" FontSize="20" VerticalAlignment="Center" Margin="0,18,0,0"
                       Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
            <StackPanel Spacing="6">
                <TextBlock x:Name="MinuteLabel" Text="分" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <ComboBox x:Name="MinuteBox" MinWidth="72" HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
