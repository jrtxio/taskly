<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.TimePickerDialog"
        Width="300" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="选择时间">

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="16,12">
            <Button x:Name="ClearBtn" Content="清除" Click="OnClear" MinWidth="64"/>
            <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" MinWidth="64"/>
            <Button x:Name="ConfirmBtn" Content="确定" Click="OnConfirm" Classes="accent" MinWidth="64"/>
        </StackPanel>
        <TimePicker x:Name="TimePicker" Margin="16" HorizontalAlignment="Center" ClockIdentifier="24HourClock"/>
    </DockPanel>
</Window>
