<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.ListEditDialog"
        Width="400" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="列表">

    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock x:Name="NameLabel" Text="列表名称" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
            <TextBox x:Name="NameBox" Watermark="列表名称"/>

            <!-- 图标 -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="IconLabel" Text="列表图标" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentBrush}"
                            Click="OnPickIcon" Padding="0">
                        <TextBlock x:Name="IconPreviewText" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="IconClearBtn" Classes="danger" Content="清除图标"
                            Click="OnClearIcon" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 颜色 -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="ColorLabel" Text="列表颜色" FontSize="13" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Width="48" Height="48" CornerRadius="24" Click="OnPickColor" Padding="0">
                        <Border x:Name="ColorPreviewBorder" CornerRadius="24"/>
                    </Button>
                    <Button x:Name="ColorClearBtn" Classes="danger" Content="清除颜色"
                            Click="OnClearColor" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="CancelBtn" Content="取消" Click="OnCancel" MinWidth="72" Padding="20,8"/>
                <Button x:Name="ConfirmBtn" Content="确定" Click="OnConfirm" Classes="accent" MinWidth="72" Padding="20,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
