<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.EmojiPicker"
        Width="350" Height="500"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="选择图标">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource ThemeDividerBrush}" BorderThickness="0,1,0,0">
            <Button Content="取消" HorizontalAlignment="Right" Click="OnCancel" MinWidth="72"/>
        </Border>

        <ScrollViewer Padding="16,16,16,0">
            <Grid x:Name="EmojiGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"/>
        </ScrollViewer>
    </DockPanel>
</Window>
