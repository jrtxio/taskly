<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taskly.Views.Dialogs.ColorPicker"
        Width="300" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Title="选择颜色">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource ThemeDividerBrush}" BorderThickness="0,1,0,0">
            <Button Content="取消" HorizontalAlignment="Right" Click="OnCancel" MinWidth="72"/>
        </Border>

        <WrapPanel x:Name="ColorWrap" Margin="16"/>
    </DockPanel>
</Window>
