<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="180"
        x:Class="Taskly.Views.Dialogs.ConfirmDialog"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Title="Taskly">

    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding DialogMessage}" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{Binding CancelLabel}"
                        Click="OnCancel"
                        Padding="20,8"
                        MinWidth="72" />
                <Button Content="{Binding ConfirmLabel}"
                        Click="OnConfirm"
                        Classes="accent"
                        Padding="20,8"
                        MinWidth="72" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
